<ModalFrame>
  <Dialog open dismissible>
    <Dialog:Header>
      <Heading size="lg" weight="semibold" as="h2">New transfer</Heading>
    </Dialog:Header>
    <Dialog:Body>
      {{ form_with url: transfers_path, id: "transfer-form", class: "flex flex-col gap-4", data: { turbo_frame: "_top" } do }}
        <Select name="from" label="From" fullwidth selected={Ledger::ACCOUNT_NAMES[0]} options={Ledger::ACCOUNT_NAMES.first(1).map { |name| { label: name, value: name } }}/>
        <Select name="to" label="To" fullwidth selected={Ledger::ACCOUNT_NAMES[1]} options={Ledger::ACCOUNT_NAMES.drop(1).first(1).map { |name| { label: name, value: name } }}/>
        <TextField id="transfer-amount" type="number" name="amount" label="Amount" prefix="$" placeholder="0.00" min="0.01" step="0.01" required autofocus fullwidth/>
      {% end %}
    </Dialog:Body>
    <Dialog:Footer>
      <Button variant="outline" data-action="orbital-modal#close">Cancel</Button>
      <Button id="transfer-submit" type="submit" form="transfer-form">Transfer money</Button>
    </Dialog:Footer>
  </Dialog>
</ModalFrame>
