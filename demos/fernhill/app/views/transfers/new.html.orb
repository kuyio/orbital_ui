<ModalFrame>
  <Dialog open dismissible>
    <Dialog:Header>
      <Heading size="lg" weight="semibold" as="h2">New transfer</Heading>
    </Dialog:Header>
    <Dialog:Body>
      <Form model={@transfer} id="transfer-form">
        <Form:Select name="from" fullwidth options={account_options}/>
        <Form:Select name="to" fullwidth options={account_options}/>
        <Form:TextField id="transfer-amount" type="number" name="amount" prefix="$" placeholder="0.00" step="0.01" autofocus fullwidth/>
      </Form>
    </Dialog:Body>
    <Dialog:Footer>
      <Button variant="outline" data-action="orbital-modal#close">Cancel</Button>
      <Button id="transfer-submit" type="submit" form="transfer-form">Transfer money</Button>
    </Dialog:Footer>
  </Dialog>
</ModalFrame>
