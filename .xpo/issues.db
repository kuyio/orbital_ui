{"id":"orbital-07708c","type":"UPDATE","payload":{"description":"Set a new baseline: `required_ruby_version` 3.4.8, `.ruby-version` 4.0.9, Rails 8.1.4.1 and `orb_template` 0.3.0. Refresh the other Ruby and JS dependencies in `orbital/` and `demo/` within minor and patch versions, and regenerate the Lucide icons.\n\nSee the spec for held-back major versions.","status":"PLANNED","sort_order":"a0","dependencies":null,"labels":null},"created_at":"2026-11-04T20:14:11.761963Z","created_by":"claude-code/2.1.318 \u003cagent@mcp\u003e","on_behalf_of":"Nicolas Bettenburg \u003cnicbet@kuy.io\u003e","source":"mcp"}
