{"id":"orbital-07708c","type":"CREATE","payload":{"title":"Update dependencies, including orb_template 0.3.0","description":"Bump `orb_template` from 0.2.5 to the published 0.3.0 and refresh the other Ruby and JS dependencies in `orbital/` and `demo/`.\n\n`orb_template` 0.3.0 requires Ruby 3.4 or newer, so the gem's declared Ruby floor has to rise with it. See the spec for scope and held-back major versions.","status":"BACKLOG","sort_order":"aL","labels":["task"]},"created_at":"2026-11-04T20:12:40.480998Z","created_by":"claude-code/2.1.318 \u003cagent@mcp\u003e","on_behalf_of":"Nicolas Bettenburg \u003cnicbet@kuy.io\u003e","source":"mcp"}
