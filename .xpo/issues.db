{"id":"orbital-4bb5a9","type":"CREATE","payload":{"title":"Update Lucide and caniuse-lite, and use made-up people in docs samples","description":"`lucide-static` and `caniuse-lite` have newer releases, so the gem misses the latest-dependencies rule. The docs site also uses a real person's name, handle and email as sample data in a public repo. Update both packages, regenerate the icons, and replace the samples with made-up people.","status":"PLANNED","sort_order":"a0","dependencies":[{"source_id":"orbital-4bb5a9","target_id":"orbital-3e0b0c","kind":"relates_to"}],"labels":["task"]},"created_at":"2026-11-06T09:05:00.666086Z","created_by":"claude-code/2.1.318 \u003cagent@mcp\u003e","on_behalf_of":"Nicolas Bettenburg \u003cnicbet@kuy.io\u003e","source":"mcp"}
