{"id":"orbital-3e0b0c","type":"CREATE","payload":{"title":"Move gem to repo root, demo to test/dummy, and meet the public gem standard","description":"Restructure the repo so the gem lives at the root and the docs app is its dummy app at `test/dummy`, slim that app, and bring the gem up to our public gem standard ahead of its first rubygems.org release. Publishing stays a separate manual step.","status":"PLANNED","sort_order":"a0","labels":["task"]},"created_at":"2026-11-05T17:38:49.904447Z","created_by":"claude-code/2.1.318 \u003cagent@mcp\u003e","on_behalf_of":"Nicolas Bettenburg \u003cnicbet@kuy.io\u003e","source":"mcp"}
